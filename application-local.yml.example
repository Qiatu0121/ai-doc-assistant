# 本地私有配置示例。
# 使用方法：
#   1. 复制为项目根目录下的 application-local.yml
#   2. 填入本地真实值
#   3. 启动时加载：
#      mvn spring-boot:run -Dspring-boot.run.arguments="--spring.config.additional-location=file:./application-local.yml"
#
# application-local.yml 已被 .gitignore 忽略，禁止提交真实凭据。

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ai_doc_assistant?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: <YOUR_DB_USERNAME>
    password: <YOUR_DB_PASSWORD>

  elasticsearch:
    uris: http://localhost:9200
    # 本地开发关闭 ES security 时留空；开启 security 时填写
    username: ""
    password: ""

  ai:
    openai:
      api-key: <YOUR_OPENAI_API_KEY>
      # 按模型供应商调整；没有自定义网关时使用默认 OpenAI 地址
      base-url: https://api.openai.com
      chat:
        options:
          model: gpt-4o-mini
      embedding:
        options:
          model: text-embedding-3-small
    vectorstore:
      elasticsearch:
        initialize-schema: true
        index-name: ai-doc-assistant
        # 必须与 Embedding 模型一致；OpenAI text-embedding-3-small 为 1536
        dimensions: 1536
        similarity: cosine
